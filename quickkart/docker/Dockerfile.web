# ==============================================================================
# QuickKart Multi-Stage Production Dockerfile
# Stage 1: Build & Package with Maven & Eclipse Temurin JDK 21
# Stage 2: Hardened, Minimal Apache Tomcat 10.1 Runtime
# ==============================================================================

# ------------------------------------------------------------------------------
# BUILD STAGE
# ------------------------------------------------------------------------------
FROM maven:3.9.9-eclipse-temurin-21-alpine AS builder
WORKDIR /workspace

# Cache Maven dependencies by copying parent and module pom.xml files first
COPY pom.xml .
COPY quickkart-common/pom.xml quickkart-common/
COPY quickkart-dao/pom.xml quickkart-dao/
COPY quickkart-web/pom.xml quickkart-web/
COPY quickkart-swing-admin/pom.xml quickkart-swing-admin/
COPY quickkart-network/pom.xml quickkart-network/
COPY quickkart-rmi/pom.xml quickkart-rmi/

# Copy all source code
COPY quickkart-common/src quickkart-common/src
COPY quickkart-dao/src quickkart-dao/src
COPY quickkart-web/src quickkart-web/src
COPY quickkart-swing-admin/src quickkart-swing-admin/src
COPY quickkart-network/src quickkart-network/src
COPY quickkart-rmi/src quickkart-rmi/src

# Build multi-module packages without running integration tests during build
RUN mvn clean package -DskipTests -pl quickkart-web -am

# ------------------------------------------------------------------------------
# PRODUCTION RUNTIME STAGE
# ------------------------------------------------------------------------------
FROM tomcat:10.1-jre21-temurin-jammy

LABEL maintainer="QuickKart DevOps Engineering <devops@quickkart.com>"
LABEL version="1.0.0"
LABEL description="Production-grade QuickKart E-Commerce Jakarta EE Web Application"

# Clean out default Tomcat sample applications
RUN rm -rf /usr/local/tomcat/webapps/*

# Copy WAR artifact as ROOT.war to bind directly to http://localhost:8080/
COPY --from=builder /workspace/quickkart-web/target/quickkart-web.war /usr/local/tomcat/webapps/ROOT.war

# Set production JVM tuning flags optimized for low-memory environment
ENV JAVA_OPTS="-Xms64m -Xmx192m -XX:+UseSerialGC -Djava.awt.headless=true -Dfile.encoding=UTF-8"
ENV DB_HOST="quickkart-mysql"
ENV DB_PORT="3306"
ENV DB_NAME="quickkart"
ENV DB_USER="quickkart_user"
ENV DB_PASSWORD="quickkart_pass"

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=35s --retries=3 \
  CMD curl -f http://localhost:8080/ || wget -q --spider http://localhost:8080/ || exit 1

CMD ["catalina.sh", "run"]
